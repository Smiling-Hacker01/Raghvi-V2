# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/db

# JWT Authentication
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI Providers (configure both, app will use primary and fallback to secondary)

# Primary provider (used first)
AI_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-key
OPENAI_MODEL=gpt-4o
OPENAI_TIMEOUT_SECONDS=15

# Gemini Configuration (fallback provider)
GEMINI_API_KEY=AIzaSy-your-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_SECONDS=15

# Groq Configuration
GROQ_API_KEY=gsk_your-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=15

# OpenRouter Configuration
OPEN_ROUTER_API_KEY=sk-or-your-key
OPEN_ROUTER_MODEL=openai/gpt-4o-mini
OPEN_ROUTER_TIMEOUT_SECONDS=15

# HuggingFace Configuration
HUGGING_FACE_API_KEY=hf_your-key
HUGGING_FACE_MODEL=microsoft/Phi-3-mini-4k-instruct
HUGGING_FACE_TIMEOUT_SECONDS=30

# GitHub Models Configuration
GITHUB_TOKEN=ghp_your-token
GITHUB_MODEL=gpt-4o
GITHUB_TIMEOUT_SECONDS=15

# ============================================
# SUBSCRIPTION & PAYMENT (Stripe)
# ============================================

# Stripe API Keys (get from https://dashboard.stripe.com/apikeys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Stripe Webhook Secret (get from https://dashboard.stripe.com/webhooks)
# Create endpoint: https://yourdomain.com/webhooks/stripe
# Listen to: customer.subscription.*, invoice.payment_*, checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ============================================
# VOICE PROVIDERS
# ============================================

# Provider Priority (comma-separated, will try in order until one succeeds)
# Options: elevenlabs, cartesia, deepgram, nvidia, coqui_xtts, coqui
# Recommended: elevenlabs,cartesia,deepgram,coqui_xtts
VOICE_PROVIDER_PRIORITY=elevenlabs,cartesia,deepgram,coqui_xtts

# ElevenLabs (Premium voice cloning & TTS) - https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# Cartesia (Fast real-time TTS with cloning) - https://cartesia.ai
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL_ID=sonic-english

# Deepgram (Fast preset voices) - https://deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=aura-asteria-en

# NVIDIA NeMo (Enterprise TTS) - https://www.nvidia.com/en-us/ai-data-science/products/nemo/
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=fastpitch

# Voice Synthesis Settings
VOICE_SAMPLE_RATE=44100
VOICE_BIT_DEPTH=16
VOICE_CHANNELS=1
VOICE_FORMAT=wav

# Voice Cloning Limits
VOICE_CLONE_MIN_DURATION=45
VOICE_CLONE_MAX_DURATION=120
VOICE_CLONE_MAX_FILE_SIZE=20971520

# ============================================
# AWS S3 (Voice File Storage)
# ============================================

# AWS Credentials
AWS_ACCESS_KEY_ID=AKIA_your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3 Bucket Configuration
S3_BUCKET=raghvi-voice-samples
S3_REGION=us-east-1
S3_VOICE_PREFIX=voices/

# ============================================
# REDIS CACHE (Optional - for voice caching)
# ============================================

# Redis configuration for caching synthesized voice
REDIS_VOICE_CACHE_TTL=1800